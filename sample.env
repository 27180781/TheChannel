# Backend
SERVER_PORT=3000
# Signs session cookies. Use a random string of at least 32 bytes (e.g. `openssl rand -hex 32`).
# Empty is a fatal boot error; shorter than 32 bytes logs a warning on every start.
SECRET_KEY=change-me-32-random-bytes-min
REDIS_ADDR=/app/data/kvrocks.sock
REDIS_PROTOCOL=unix

# Google-oauth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_USERS=example@gmail.com,example1@gmail.com

# Cloudflare R2 Storage (optional — if not set, files stored locally in /app/files/)
# To enable R2, uncomment all four lines below and fill in real values.
# Do not leave the placeholders in: R2 switches on as soon as the four values are
# non-empty, so a placeholder points every upload at an endpoint that does not
# exist and each upload fails with 500.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# Optional: public bucket URL for direct redirects. Leave unset for a private
# bucket (pre-signed URLs). Comments stay on their own line on purpose: with
# `docker run --env-file` and the CapRover bulk editor, an inline "# ..." after a
# value becomes part of the value.
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
